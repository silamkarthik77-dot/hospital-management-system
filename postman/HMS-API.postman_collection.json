{
  "info": {
    "name": "Hospital Management System API",
    "description": "Collection for the HMS Spring Boot backend. Set {{baseUrl}} and {{token}} in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Patient\",\n  \"email\": \"test.patient@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"9999999999\",\n  \"dateOfBirth\": \"1995-01-01\",\n  \"gender\": \"Female\",\n  \"bloodGroup\": \"O+\",\n  \"address\": \"Hyderabad\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hms.com\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@hms.com\"\n}" }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/reset-password",
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"paste-token-here\",\n  \"newPassword\": \"NewPassword@123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        { "name": "List All Doctors", "request": { "method": "GET", "url": "{{baseUrl}}/doctors" } },
        { "name": "Get Doctor By Id", "request": { "method": "GET", "url": "{{baseUrl}}/doctors/1" } },
        { "name": "Doctors By Department", "request": { "method": "GET", "url": "{{baseUrl}}/doctors/department/1" } }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book Appointment (Patient)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2026-08-01\",\n  \"appointmentTime\": \"10:00:00\",\n  \"reasonForVisit\": \"General checkup\"\n}"
            }
          }
        },
        {
          "name": "My Appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/appointments/my"
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/appointments/1?reason=Change of plans"
          }
        },
        {
          "name": "Doctor Schedule for Date",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/appointments/doctor/schedule?date=2026-08-01"
          }
        },
        {
          "name": "Update Diagnosis (Doctor)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/appointments/1/diagnosis",
            "body": { "mode": "raw", "raw": "{\n  \"diagnosisNotes\": \"Prescribed rest and hydration.\"\n}" }
          }
        },
        {
          "name": "Confirm Appointment (Admin/Receptionist)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/appointments/1/confirm"
          }
        },
        {
          "name": "All Appointments (Admin/Receptionist)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/appointments"
          }
        }
      ]
    },
    {
      "name": "Medical Reports",
      "item": [
        {
          "name": "Upload Report (Doctor/Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/medical-reports?patientId=1&title=Blood Test&description=Routine panel",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            }
          }
        },
        {
          "name": "Reports for Patient",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/medical-reports/patient/1"
          }
        },
        {
          "name": "Get Download URL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/medical-reports/1/download-url"
          }
        },
        {
          "name": "Delete Report",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/medical-reports/1"
          }
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "Create Invoice (Admin/Receptionist)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/billing/invoices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"billType\": \"CONSULTATION\",\n  \"amount\": 800.00,\n  \"taxAmount\": 40.00\n}"
            }
          }
        },
        {
          "name": "Make Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/billing/pay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": 1,\n  \"amount\": 840.00,\n  \"paymentMethod\": \"CARD\"\n}"
            }
          }
        },
        {
          "name": "My Invoices (Patient)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/billing/my"
          }
        },
        {
          "name": "All Invoices (Admin/Receptionist)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/billing/invoices"
          }
        },
        {
          "name": "Download Invoice PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/billing/invoices/1/pdf"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "All Patients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/patients"
          }
        }
      ]
    },
    {
      "name": "Patient Self-Service",
      "item": [
        {
          "name": "My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/patients/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/patients/me",
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"New address, Hyderabad\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Receptionist",
      "item": [
        {
          "name": "Search Patients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/receptionist/patients/search?query=Ritika"
          }
        },
        {
          "name": "All Patients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/receptionist/patients"
          }
        }
      ]
    }
  ]
}
