# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
DB_NAME=hms_db
DB_USERNAME=hms_user
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
DDL_AUTO=validate

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-base64-string-min-256-bits

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- AWS ---
AWS_REGION=ap-south-1
S3_BUCKET_NAME=hms-medical-reports
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
